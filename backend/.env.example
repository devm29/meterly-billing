METERLY_ENV=development
METERLY_LOG_LEVEL=INFO
METERLY_LOG_JSON=false
METERLY_DATABASE_URL=postgresql+asyncpg://meterly@localhost:5507/meterly
METERLY_REDIS_URL=redis://localhost:6407/0
METERLY_CORS_ORIGINS=["http://localhost:3107"]
# Admin key: console, plans, invoices, billing runs. Ingest key: events and entitlement checks.
# Production refuses to start with the development defaults.
METERLY_ADMIN_API_KEY=mtr_admin_dev_only
METERLY_INGEST_API_KEY=mtr_ingest_dev_only
METERLY_MAX_BATCH_SIZE=1000
# Wait this long after a period ends before closing it, so late events can land.
METERLY_CLOSE_GRACE_MINUTES=60
# Drafts stay open for re-rating this long before the worker finalizes them.
METERLY_DRAFT_REVIEW_HOURS=72
METERLY_ENTITLEMENT_CACHE_TTL_SECONDS=15
METERLY_INVOICE_NUMBER_PREFIX=MTR
